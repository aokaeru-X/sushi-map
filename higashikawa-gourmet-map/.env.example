# ---- Notion (Headless CMS) ----
# https://www.notion.so/my-integrations で作成したインテグレーションのシークレット
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 「東川町グルメ店舗一覧」データベースの ID（URL の 32 桁）
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 未接続でも同梱サンプルデータで動かす場合は true
USE_SEED_DATA=false

# ---- On-Demand ISR ----
# /api/revalidate を叩くための共有シークレット
REVALIDATE_SECRET=change-me-revalidate

# ---- URL インジェスト ----
# /api/admin/ingest を叩くための管理トークン
ADMIN_TOKEN=change-me-admin

# LLM プロバイダ: anthropic（既定）| gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 既定: claude-opus-5
ANTHROPIC_MODEL=claude-opus-5
# LLM_PROVIDER=gemini のときに使用
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- サイト ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
